# Copy this file to .env and fill in your own values. NEVER commit .env.

# Required. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin account, created automatically on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to 1 only for local development
FLASK_DEBUG=0

# Optional: demo data (a demo citizen + 5 sample complaints)
SEED_DEMO_DATA=0
DEMO_PASSWORD=

# Optional overrides
# DATABASE_URL=sqlite:///roadcare.db
# PORT=5000